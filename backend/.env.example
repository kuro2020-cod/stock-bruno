PORT=3001
NODE_ENV=production

# Escuchar en todas las interfaces (0.0.0.0) para acceder desde otra PC o desde internet.
# En el router: reenvío de puertos TCP 3001 → IP local de esta PC.
# Desde fuera de la red el sistema solo abre Faltantes y Pedidos.
# Usar 127.0.0.1 solo si querés bloquear el acceso desde la red local.
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock
DB_USER=postgres
DB_PASSWORD=TU_CLAVE_DE_POSTGRES

JWT_SECRET=cambiar-por-una-clave-larga-y-secreta-unica

# SMTP para reporte diario de faltantes + stock bajo (PDF por email)
# Gmail: activá verificación en 2 pasos y creá una "contraseña de aplicación":
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Access Token de PRODUCCIÓN de tu cuenta real (no el de "Prueba" ni TESTUSER).
# Panel: https://www.mercadopago.com.ar/developers/panel/app → tu app → Credenciales de producción.
# Si usás un token de prueba, la app no va a ver las transferencias de tu cuenta real.
# Solo se usa para consultar cobros. No se muestra saldo ni se hacen transferencias.
MERCADOPAGO_ACCESS_TOKEN=

# Cobro con QR fijo: external_id de la caja (POS) en Mercado Pago (mismo valor al crear la caja).
# Al cobrar por transferencia, se envía el monto a ese POS; el cliente escanea el QR fijo.
# MERCADOPAGO_EXTERNAL_POS_ID=CAJA01

# Asistente de catálogo (solo ADMIN). Opcional: si no hay clave, usa frases simples.
# OpenAI (o compatible: Groq, OpenRouter, etc. con OPENAI_BASE_URL)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Forzar proveedor: openai | gemini | local
# ASISTENTE_PROVEEDOR=
